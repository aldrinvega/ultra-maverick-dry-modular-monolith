# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit it.

# SQL Server SA password (must meet SQL Server complexity: 8+ chars, upper/lower/digit/symbol)
MSSQL_SA_PASSWORD=Change_this_Strong!Passw0rd

# JWT signing key: 64 random bytes, base64.
# Generate with:
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $b = New-Object byte[] 64; $rng.GetBytes($b); [Convert]::ToBase64String($b)
JWT_KEY=replace-with-a-64-byte-base64-key

# Token identifiers (must match between issuance and validation)
JWT_ISSUER=https://localhost:5007
JWT_AUDIENCE=ultramaverick-client
