{
  "info": {
    "name": "Ultramaverick Dry - Identity",
    "_postman_id": "b7f2c1a4-3d6e-4a91-9c2b-7e5f0a1d8c34",
    "description": "Identity module of the Ultramaverick Dry modular monolith.\n\nRun 'Authenticate (login)' first: it stores accessToken/refreshToken as collection variables. All Users requests use the Bearer token automatically.\n\nBase URL default is the http launch profile (http://localhost:5160). If you run the https profile, change baseUrl to https://localhost:7244.\n\nSeeded admin: admin / Admin@123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5160" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "2" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Authenticate (login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin\",\n  \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login/authenticate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login", "authenticate"]
            },
            "description": "Anonymous. Returns an access token (JWT with sub/name/role/modules claims), its expiry, and a refresh token. Wrong password returns 400 with a generic message."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (active, paged)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/User/GetAllUsersWithPagination/true?page=1&pageSize=20&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "GetAllUsersWithPagination", "true"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" }
              ]
            },
            "description": "Paged envelope: { items, page, pageSize, totalCount, totalPages }. status in the path is true/false for active/inactive."
          }
        },
        {
          "name": "List users (inactive, paged)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/User/GetAllUsersWithPagination/false?page=1&pageSize=20&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "GetAllUsersWithPagination", "false"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/User/GetById/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "GetById", "{{userId}}"]
            },
            "description": "Returns the UserDto (id, fullName, userName, roleId, roleName, departmentId, departmentName, isActive). 404 if not found."
          }
        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.response.json();",
                  "if (typeof id === 'number') {",
                  "    pm.collectionVariables.set('userId', id);",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"userName\": \"testuser\",\n  \"password\": \"Test@1234\",\n  \"roleId\": 3,\n  \"departmentId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/User/AddNewUser",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "AddNewUser"]
            },
            "description": "Password is hashed (PBKDF2) before storage; it is never returned. roleId 3 = Encoder, departmentId 1 = Warehouse. Returns the new user id and stores it in the userId collection variable."
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"fullName\": \"Test User Updated\",\n  \"userName\": \"testuser\",\n  \"roleId\": 3,\n  \"departmentId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/User/UpdateUserInfo/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "UpdateUserInfo", "{{userId}}"]
            },
            "description": "The route id and body userId must match, or it returns 400. Returns 204 on success."
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/User/InActiveUser/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "InActiveUser", "{{userId}}"]
            },
            "description": "Sets IsActive = false and raises UserChanged(Deactivated), which is written to Infrastructure.OutboxMessages."
          }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/User/ActivateUser/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "ActivateUser", "{{userId}}"]
            },
            "description": "Sets IsActive = true and raises UserChanged(Activated)."
          }
        },
        {
          "name": "Get user by id (no token -> 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/User/GetById/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "GetById", "1"]
            },
            "description": "Authorization check: without a bearer token this returns 401. With a token whose role lacks the Identity module it returns 403."
          }
        }
      ]
    },
    {
      "name": "Diagnostics",
      "item": [
        {
          "name": "OpenAPI document (dev only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/openapi/v1.json",
              "host": ["{{baseUrl}}"],
              "path": ["openapi", "v1.json"]
            },
            "description": "Available only when ASPNETCORE_ENVIRONMENT=Development."
          }
        }
      ]
    }
  ]
}
