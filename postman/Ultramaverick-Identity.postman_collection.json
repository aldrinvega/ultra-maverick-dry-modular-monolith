{
  "info": {
    "name": "Ultramaverick Dry - Identity",
    "_postman_id": "b7f2c1a4-3d6e-4a91-9c2b-7e5f0a1d8c34",
    "description": "Identity module of the Ultramaverick Dry modular monolith.\n\nRun 'Authenticate (login)' first: it stores accessToken/refreshToken as collection variables. All Users/Roles/Departments/Modules requests use the Bearer token automatically.\n\nBase URL default is the http launch profile (http://localhost:5160). For the https profile use https://localhost:7244.\n\nSeeded admin: admin / Admin@123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5160" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "2" },
    { "key": "roleId", "value": "4" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Authenticate (login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin\",\n  \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login/authenticate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login", "authenticate"]
            },
            "description": "Anonymous, rate limited (10/minute per client address). Returns accessToken, its expiry, and refreshToken. A missing user, wrong password, and inactive user all return the same generic message."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login", "refresh"]
            },
            "description": "Anonymous. Single-use rotation: the presented token is consumed and a new access + refresh token pair is issued. Reusing a consumed or revoked token returns 401."
          }
        },
        {
          "name": "Revoke",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login/revoke",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login", "revoke"]
            },
            "description": "Anonymous (possession of the refresh token is the credential). Idempotent; returns 204."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users (active, paged)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/User/GetAllUsersWithPagination/true?page=1&pageSize=20&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "GetAllUsersWithPagination", "true"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "List users (inactive, paged)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/User/GetAllUsersWithPagination/false?page=1&pageSize=20&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "GetAllUsersWithPagination", "false"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/User/GetById/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "GetById", "{{userId}}"]
            }
          }
        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.response.json();",
                  "if (typeof id === 'number') { pm.collectionVariables.set('userId', id); }",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"userName\": \"testuser\",\n  \"password\": \"Test@1234\",\n  \"roleId\": 3,\n  \"departmentId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/User/AddNewUser",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "AddNewUser"]
            }
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"fullName\": \"Test User Updated\",\n  \"userName\": \"testuser\",\n  \"roleId\": 3,\n  \"departmentId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/User/UpdateUserInfo/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "UpdateUserInfo", "{{userId}}"]
            }
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/User/InActiveUser/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "InActiveUser", "{{userId}}"]
            }
          }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/User/ActivateUser/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "User", "ActivateUser", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/Role/GetAllRoles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Role", "GetAllRoles"]
            }
          }
        },
        {
          "name": "Create role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.response.json();",
                  "if (typeof id === 'number') { pm.collectionVariables.set('roleId', id); }",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Auditor\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Role/AddNewRole",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Role", "AddNewRole"]
            }
          }
        },
        {
          "name": "Tag modules on role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": {{roleId}},\n  \"moduleIds\": [1, 2, 3]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Role/TagandModules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Role", "TagandModules"]
            },
            "description": "Replaces the role's module grants with the supplied set. An empty array clears them. Unknown module ids return 400."
          }
        },
        {
          "name": "Get role modules",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/Role/GetRoleModules/{{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Role", "GetRoleModules", "{{roleId}}"]
            }
          }
        },
        {
          "name": "Untag modules from role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": {{roleId}},\n  \"moduleIds\": [3]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/Role/UntagModule",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Role", "UntagModule"]
            }
          }
        }
      ]
    },
